# ===== LLM 配置（必填二选一）=====
# 方式一：使用 OpenAI 兼容 API（国内推荐 DeepSeek / 通义 / Kimi 等）

# DeepSeek（性价比最高，支持 128k 上下文）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 通义千问（阿里）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Kimi（月之暗面）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# 方式二：本地 Ollama（完全免费，需提前安装）
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ===== 嵌入模型配置（与 LLM 独立）=====
# 通常使用 OpenAI text-embedding-3-small 或本地模型
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ===== 切片参数（可选）=====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
